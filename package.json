{
  "name": "mega-math-blaster-remake",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Faithful fan recreation of Mega Math Blaster (1996) with original cartoon art",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "host": "vite --host 0.0.0.0",
    "assets": "node scripts/generate-assets.mjs",
    "typecheck": "tsc",
    "build:single": "vite build --config vite.single.config.ts && node scripts/make-single-file.mjs",
    "build:pages": "vite build --config vite.pages.config.ts && node scripts/finish-pages.mjs"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.6.0"
  }
}
